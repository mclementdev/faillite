# --- Stockage (Redis Upstash) -------------------------------------------------
# Renseignées automatiquement par l'intégration Upstash du Marketplace Vercel
# (KV_REST_API_URL / KV_REST_API_TOKEN) ; les noms UPSTASH_* fonctionnent aussi.
# Sans ces variables, le jeu utilise un stockage en mémoire : OK en local, PAS en production.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Temps réel ----------------------------------------------------------------
# Aucune clé nécessaire : interrogation régulière mise en cache 1 s par le CDN de Vercel.

# --- Backoffice (/admin) -----------------------------------------------------------
# Adresses autorisées, séparées par des virgules (insensible à la casse).
# Valeur par défaut si la variable est absente : emmanuel@macron.fr
ADMIN_EMAILS=emmanuel@macron.fr
# Secret de signature des sessions (32 caractères aléatoires ou plus). OBLIGATOIRE en production.
# Générer : openssl rand -base64 32
ADMIN_SESSION_SECRET=
# Optionnel : si défini, le formulaire demande aussi ce code en plus de l'e-mail.
ADMIN_ACCESS_CODE=
